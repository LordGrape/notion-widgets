  "description": "Musbah's private companion for Notion, law school, and life.",
  "lang": "en-CA",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
