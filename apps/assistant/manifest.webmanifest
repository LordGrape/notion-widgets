    {"name": "Clock", "short_name": "Clock", "url": "./?panel=clock", "description": "Jump straight to the focus clock"},
    {"name": "Timetable", "short_name": "Timetable", "url": "./?panel=timetable", "description": "Jump straight to your timetable"}
  ]
